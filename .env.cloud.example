# Non-secret deployment identifiers only. Copy to .env.cloud, which is ignored.
AWS_REGION=ap-southeast-1
AWS_PROFILE=continuum-hackathon
CONTINUUM_DEPLOY_BUCKET=replace-with-a-globally-unique-private-bucket
CONTINUUM_COCKROACH_CLUSTER_ID=replace-with-cluster-id
CONTINUUM_COCKROACH_MCP_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:replace-me
CONTINUUM_BUDGET_EMAIL=replace-with-verified-owner@example.com
CONTINUUM_MONTHLY_BUDGET_USD=5
CONTINUUM_AWS_BUDGET_NAME=continuum-hackathon-monthly-cost
